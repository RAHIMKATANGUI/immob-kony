# =====================================================================
#  IMMOB KONY — variables d'environnement
#  Copier en .env (local) — sur Render, elles sont définies par render.yaml
# =====================================================================

# --- Base de données PostgreSQL --------------------------------------
DATABASE_URL="postgresql://immob:immob@localhost:5432/immob_kony"
# URL directe (sans pooler) pour les migrations — identique à DATABASE_URL sur Render
DIRECT_URL="postgresql://immob:immob@localhost:5432/immob_kony"
DATABASE_POOL_SIZE=10

# --- Application ------------------------------------------------------
APP_URL="http://localhost:3000"
APP_NAME="IMMOB KONY"
CURRENCY="XOF"
NEXT_PUBLIC_CURRENCY="XOF"

# --- Sécurité ---------------------------------------------------------
# 32 caractères minimum : openssl rand -base64 48
JWT_SECRET="remplacez-moi-par-une-valeur-aleatoire-de-48-caracteres"
JWT_EXPIRES_IN="8h"
# Secret de la tâche planifiée (Authorization: Bearer ...)
CRON_SECRET="remplacez-moi"

# --- Emails (Resend) ----------------------------------------------------
# Sans clé : les emails sont journalisés dans la console (développement)
RESEND_API_KEY=""
EMAIL_FROM="IMMOB KONY <noreply@votre-domaine.com>"

# --- Stockage (Cloudinary) ----------------------------------------------
# Sans configuration : stockage en data URL (développement uniquement, 1 Mo max)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- SMS (intégration préparée) -----------------------------------------
# console | twilio | http
SMS_PROVIDER="console"
SMS_SENDER="IMMOBKONY"
# twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# http (Orange SMS API, MTN, Infobip… via une passerelle compatible)
SMS_API_URL=""
SMS_API_KEY=""
